<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd"
         version="3.1">

    <display-name>Parqueadero Boyacá - API REST</display-name>

    <!-- Filtro CORS para permitir peticiones desde PHP -->
    <filter>
        <filter-name>CORSFilter</filter-name>
        <filter-class>sena.adso.parqueadero.util.CORSFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CORSFilter</filter-name>
        <url-pattern>/api/*</url-pattern>
    </filter-mapping>

    <!-- Servlets API REST -->
    <servlet>
        <servlet-name>VehiculoServlet</servlet-name>
        <servlet-class>sena.adso.parqueadero.servlet.VehiculoServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>VehiculoServlet</servlet-name>
        <url-pattern>/api/vehiculos/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RegistroServlet</servlet-name>
        <servlet-class>sena.adso.parqueadero.servlet.RegistroServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegistroServlet</servlet-name>
        <url-pattern>/api/registros/*</url-pattern>
    </servlet-mapping>

</web-app>
